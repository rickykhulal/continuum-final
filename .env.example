# Continuum environment. Copy to .env and fill in locally.
# Secret values never go in the repository or the client bundle.

ENVIRONMENT=development
NODE_ENV=development
LOG_LEVEL=info
LOG_FORMAT=json

# --- Data bundle ------------------------------------------------------------
# Directory holding live_fires.json, snapshot.json, land-110m.json and bundle_manifest.json
# flat (no `data/` subfolder). Both integrity gates — GET /ready and `npm run validate` — certify
# this directory and only this directory once it is set, so a partially copied mount fails loudly.
# Build it with `npm run data && npm run bundle`.
DATA_BUNDLE_PATH=public/data
# Leave DATA_BUNDLE_VERSION unset: it is read from the content-hashed manifest.

# --- Read-only API ----------------------------------------------------------
PORT=8787
API_MAX_AREA_KM2=250000
API_MAX_UPLOAD_MB=2
API_RATE_LIMITS=classA:120/min;classB:60/min;classC:20/min
API_CORS_ORIGINS=http://localhost:5173,http://localhost:4174
PUBLIC_API_BASE_URL=http://localhost:8787/api/v1
# Render: mount a persistent disk at /var/data and set APP_DATA_PATH=/var/data/continuum.
APP_DATA_PATH=data
# Same-origin Render hosting needs no VITE_API_BASE. A split frontend sets it at build time.
# VITE_API_BASE=https://your-api-service.onrender.com/api/v1

# --- Community integrations (server-only, never prefix with VITE_) ----------
# The API and bot load these integration settings from ignored .env; exported values win.
DISCORD_WEBHOOK_URL=""
# Use the same random secret on API and bot; replace this documented placeholder.
DISCORD_SYNC_SECRET="<generate-a-random-shared-secret>"
DISCORD_BOT_TOKEN="<your-discord-bot-token>"
DISCORD_REPORT_CHANNEL_ID="<your-channel-id>"
DISCORD_REPORT_CHANNEL_NAME=fire-reports
DISCORD_GUILD_ID=
GROQ_API_KEY="<your-groq-api-key>"
GROQ_MODEL="llama-3.1-8b-instant"
COMMUNITY_API_URL=http://127.0.0.1:8787/api/v1

# --- NASA FIRMS (optional for open live CSVs; required for keyed backfill) --
FIRMS_MAP_KEY="<your-nasa-firms-map-key>"
EARTHDATA_TOKEN=

# --- Feature flags ----------------------------------------------------------
ENABLE_WEATHER=true
ENABLE_TWIN=true
ENABLE_SANDBOX=true
ENABLE_STATIC_SOURCE_FILTER=true
ENABLE_ES=true
ANALYTICS_ENABLED=false
ENABLE_LLM_SUMMARY=false
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# --- Optional observability -------------------------------------------------
# Prometheus text scrape served by the API at GET /metrics (and /api/v1/metrics).
# Leave empty and the endpoint answers 404, which is the safe default. Set it to a
# long random value on the host — never commit the value, and never print it in logs.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
METRICS_TOKEN=
SENTRY_DSN=
BASEMAP_STYLE_URL=
